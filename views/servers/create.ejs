<%- include("../layouts/head") %>

<%- include("../components/page-hero", {
  icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z" clip-rule="evenodd" /></svg>',
  iconClass: 'bg-indigo-50 dark:bg-indigo-950 border border-indigo-100/50 text-indigo-500 dark:text-indigo-400',
  gradient: 'from-indigo-50 to-blue-100',
  title: 'Deploy Server',
  subtitle: 'Create a new server with your available resources.',
  action: '<a href="../servers" class="inline-flex items-center rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2 text-sm font-medium text-gray-600 dark:text-slate-400 hover:bg-gray-50 dark:hover:bg-slate-800 dark:bg-slate-800 transition-colors">Back to Servers</a>'
}) %>

          <% if (req.query.err) { %>
          <div class="rounded-2xl bg-rose-50 border border-rose-200 p-6 mb-6">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-rose-500">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2.25m0 4.5h.008v.008H12v-.008Zm8.25-.75a8.25 8.25 0 1 1-16.5 0 8.25 8.25 0 0 1 16.5 0Z" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-rose-800">Deploy failed</h3>
                <div class="mt-2 text-sm text-rose-700"><p>Error code: <code><%= req.query.err %></code></p></div>
                <% if (req.query.detail) { %>
                <div class="mt-2 text-sm text-rose-700"><p><%= req.query.detail %></p></div>
                <% } %>
              </div>
            </div>
          </div>
          <% } %>

          <% if (availableRam > 0) { %>
          <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
            <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-3xl p-8 shadow-sm">
              <div class="mb-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Server configuration</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Choose a name, location, software, and resource limits.</p>
              </div>

              <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                <div class="md:col-span-2">
                  <label for="name" class="text-sm font-medium text-gray-700 dark:text-slate-300">Server name</label>
                  <input type="text" id="name" placeholder="My server" class="mt-2 w-full rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm text-gray-700 dark:text-slate-300 shadow-sm focus:border-indigo-400 focus:ring-indigo-500">
                </div>
                <div>
                  <label for="location" class="text-sm font-medium text-gray-700 dark:text-slate-300">Location</label>
                  <select id="location" class="mt-2 w-full rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm text-gray-700 dark:text-slate-300 shadow-sm focus:border-indigo-400 focus:ring-indigo-500">
                    <% for (let [name, value] of Object.entries(settings.api.client.locations)) { %>
                    <option value="<%= name %>"><%= value.name %></option>
                    <% } %>
                  </select>
                </div>
                <div>
                  <label for="egg" class="text-sm font-medium text-gray-700 dark:text-slate-300">Software</label>
                  <select id="egg" class="mt-2 w-full rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm text-gray-700 dark:text-slate-300 shadow-sm focus:border-indigo-400 focus:ring-indigo-500">
                    <% for (let [name, value] of Object.entries(settings.api.client.eggs)) { %>
                    <option value="<%= name %>"><%= value.display %></option>
                    <% } %>
                  </select>
                </div>
                <div>
                  <label for="ram" class="text-sm font-medium text-gray-700 dark:text-slate-300">Memory (GiB)</label>
                  <input type="text" id="ram" value="<%= availableRam %>" class="mt-2 w-full rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm text-gray-700 dark:text-slate-300 shadow-sm focus:border-indigo-400 focus:ring-indigo-500">
                </div>
                <div>
                  <label for="disk" class="text-sm font-medium text-gray-700 dark:text-slate-300">Storage (GiB)</label>
                  <input type="text" id="disk" value="<%= availableDisk %>" class="mt-2 w-full rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm text-gray-700 dark:text-slate-300 shadow-sm focus:border-indigo-400 focus:ring-indigo-500">
                </div>
                <div>
                  <label for="cpu" class="text-sm font-medium text-gray-700 dark:text-slate-300">CPU Cores</label>
                  <input type="text" id="cpu" value="<%= availableCpu %>" class="mt-2 w-full rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm text-gray-700 dark:text-slate-300 shadow-sm focus:border-indigo-400 focus:ring-indigo-500">
                </div>
              </div>

              <div class="mt-8 flex flex-wrap gap-3">
                <button id="submitButton" onclick="submitForm()" class="inline-flex items-center rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors">
                  <span id="contentWrapper">Create Server</span>
                  <span id="loaderWrapper" class="hidden">
                    <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                  </span>
                </button>
                <a href="../servers" class="inline-flex items-center rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-6 py-3 text-sm font-medium text-gray-600 dark:text-slate-400 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">Cancel</a>
              </div>
            </div>

            <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-3xl p-8 shadow-sm">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Available resources</h3>
              <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Current capacity you can still allocate.</p>
              <dl class="mt-6 space-y-4">
                <div class="flex items-center justify-between rounded-2xl bg-gray-50 dark:bg-slate-800 px-4 py-3">
                  <dt class="text-sm text-gray-500 dark:text-slate-400">Memory</dt>
                  <dd class="text-sm font-semibold text-gray-900 dark:text-slate-100"><%= availableRam %> GiB</dd>
                </div>
                <div class="flex items-center justify-between rounded-2xl bg-gray-50 dark:bg-slate-800 px-4 py-3">
                  <dt class="text-sm text-gray-500 dark:text-slate-400">Storage</dt>
                  <dd class="text-sm font-semibold text-gray-900 dark:text-slate-100"><%= availableDisk %> GiB</dd>
                </div>
                <div class="flex items-center justify-between rounded-2xl bg-gray-50 dark:bg-slate-800 px-4 py-3">
                  <dt class="text-sm text-gray-500 dark:text-slate-400">CPU</dt>
                  <dd class="text-sm font-semibold text-gray-900 dark:text-slate-100"><%= availableCpu %> Cores</dd>
                </div>
                <div class="flex items-center justify-between rounded-2xl bg-gray-50 dark:bg-slate-800 px-4 py-3">
                  <dt class="text-sm text-gray-500 dark:text-slate-400">Server slots</dt>
                  <dd class="text-sm font-semibold text-gray-900 dark:text-slate-100"><%= availableServers %></dd>
                </div>
              </dl>
            </div>
          </div>
          <script>
            function submitForm() {
              document.getElementById('contentWrapper').classList.add('hidden');
              document.getElementById('loaderWrapper').classList.remove('hidden');
              document.getElementById('submitButton').setAttribute('disabled', 'disabled');
              let name = encodeURIComponent(document.getElementById("name").value);
              let egg = encodeURIComponent(document.getElementById("egg").value);
              let ram = encodeURIComponent(document.getElementById("ram").value);
              let disk = encodeURIComponent(document.getElementById("disk").value);
              let cpu = encodeURIComponent(document.getElementById("cpu").value);
              let location = encodeURIComponent(document.getElementById("location").value);
              document.location.href = `/create?name=${name}&egg=${egg}&ram=${ram*1024}&disk=${disk*1024}&cpu=${cpu*100}&location=${location}&token=<%= csrfToken %>`;
            }
          </script>
          <% } else { %>
          <div class="text-center bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700/60 dark:border-slate-700 rounded-3xl py-24 px-6 shadow-sm">
            <div class="mx-auto h-16 w-16 bg-amber-50 dark:bg-amber-950 rounded-2xl flex items-center justify-center border border-amber-100 dark:border-amber-800 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8 text-amber-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold tracking-tight text-gray-900 dark:text-slate-100">Insufficient resources</h3>
            <p class="mt-2 text-sm text-gray-500 dark:text-slate-400 max-w-sm mx-auto">You need at least 1 GiB of free memory before you can deploy a new server.</p>
            <div class="mt-8">
              <a href="../servers" class="inline-flex items-center rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-6 py-2.5 text-sm font-medium text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">Back to Servers</a>
            </div>
          </div>
          <% } %>
<%- include("../layouts/tail") %>
