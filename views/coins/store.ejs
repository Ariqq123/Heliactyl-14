<head>
  <title><%= settings.name %></title>
  <link rel="icon" type="image/x-icon" href="../assets/favicon.png">
  <link rel="stylesheet" href="../assets/tailwind.css">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://unpkg.com/@popperjs/core@2.10.1/dist/umd/popper.min.js"></script>
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-gray-100 flex h-screen overflow-x-hidden" style="font-family: 'Inter', sans-serif;">
  <%- include('../components/navigation') %>
  <div class="flex-1 min-w-0 flex flex-col h-screen overflow-y-auto">
    <main class="flex-1 pb-32">
      <div class="py-6">
        <%- include('../components/skeleton') %>
        <div class="hidden max-w-7xl pt-8 mx-auto px-4 sm:px-6 md:px-8" id="content">

          <!-- Hero -->
          <div class="relative overflow-hidden bg-white border border-gray-200/60 rounded-3xl mb-8 p-8 shadow-sm">
            <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-gradient-to-br from-emerald-50 to-teal-100 opacity-50 blur-3xl"></div>
            <div class="relative lg:flex lg:items-center lg:justify-between">
              <div class="flex items-center">
                <div class="bg-emerald-50 border border-emerald-100/50 rounded-2xl h-14 w-14 flex items-center justify-center text-emerald-500 shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path fill-rule="evenodd" d="M7.5 6v.75H5.513c-.96 0-1.764.724-1.865 1.679l-1.263 12A1.875 1.875 0 0 0 4.25 22.5h15.5a1.875 1.875 0 0 0 1.865-2.071l-1.263-12a1.875 1.875 0 0 0-1.865-1.679H16.5V6a4.5 4.5 0 1 0-9 0ZM12 3a3 3 0 0 0-3 3v.75h6V6a3 3 0 0 0-3-3Zm-3 8.25a3 3 0 1 0 6 0v-.75a.75.75 0 0 1 1.5 0v.75a4.5 4.5 0 1 1-9 0v-.75a.75.75 0 0 1 1.5 0v.75Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-5">
                  <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Store</h2>
                  <p class="mt-1 text-sm text-gray-500">Spend coins to expand your account quotas.</p>
                </div>
              </div>
              <div class="mt-6 lg:mt-0 inline-flex items-center rounded-2xl bg-amber-50 border border-amber-200/60 px-4 py-2 text-amber-800 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 mr-2 text-amber-500">
                  <path d="M8 12.5c1.84 0 3.579-.37 4.914-1.037.366-.183.74-.41 1.086-.684V12c0 1.657-2.686 3-6 3s-6-1.343-6-3v-1.22c.346.273.72.5 1.087.683C4.42 12.131 6.16 12.5 8 12.5Z" />
                </svg>
                <span class="text-sm font-semibold"><%= coins.toFixed(2) %> coins available</span>
              </div>
            </div>
          </div>

          <!-- Alerts -->
          <% if (req.query.err) { %>
          <% if (req.query.err == "none") { %>
          <div class="rounded-2xl bg-emerald-50 border border-emerald-200 p-6 mb-6">
            <div class="flex">
              <svg class="h-6 w-6 text-emerald-500 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-emerald-800">Resources purchased</h3>
                <p class="mt-1 text-sm text-emerald-700">You can now edit one of your servers and add the extra resources.</p>
              </div>
            </div>
          </div>
          <% } else { %>
          <div class="rounded-2xl bg-rose-50 border border-rose-200 p-6 mb-6">
            <div class="flex">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-rose-500 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-rose-800">Purchase failed</h3>
                <p class="mt-1 text-sm text-rose-700">Error code: <code><%= req.query.err %></code></p>
              </div>
            </div>
          </div>
          <% } %>
          <% } %>

          <!-- Pricing grid -->
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">

            <!-- Memory card -->
            <div class="bg-white border border-gray-200/60 rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center mb-4">
                <div class="bg-indigo-50 text-indigo-600 rounded-xl p-2.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" /></svg></div>
                <h3 class="ml-3 text-base font-semibold text-gray-900">Memory</h3>
              </div>
              <p class="text-xs text-gray-500 mb-4"><%= settings.api.client.coins.store.ram.per/1024 %> GiB per <%= settings.api.client.coins.store.ram.cost %> coin<%= settings.api.client.coins.store.ram.cost == 1 ? "" : "s" %></p>
              <select id="ram" class="w-full mb-3 px-4 py-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:border-indigo-400 focus:ring-indigo-500 text-gray-700">
                <% for (let m = 1; m <= 10; m++) { %>
                <option value="<%= m %>"><%= settings.api.client.coins.store.ram.per/1024 * m %> GiB &mdash; <%= settings.api.client.coins.store.ram.cost * m %> coin<%= (settings.api.client.coins.store.ram.cost * m) == 1 ? "" : "s" %></option>
                <% } %>
              </select>
              <button onclick="buyRAM()" class="w-full inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700 transition-colors">Purchase Memory</button>
            </div>

            <!-- CPU card -->
            <div class="bg-white border border-gray-200/60 rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center mb-4">
                <div class="bg-blue-50 text-blue-600 rounded-xl p-2.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" /></svg></div>
                <h3 class="ml-3 text-base font-semibold text-gray-900">CPU</h3>
              </div>
              <p class="text-xs text-gray-500 mb-4"><%= settings.api.client.coins.store.cpu.per/100 %> Core(s) per <%= settings.api.client.coins.store.cpu.cost %> coin<%= settings.api.client.coins.store.cpu.cost == 1 ? "" : "s" %></p>
              <select id="cpu" class="w-full mb-3 px-4 py-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:border-blue-400 focus:ring-blue-500 text-gray-700">
                <% for (let c = 1; c <= 10; c++) { %>
                <option value="<%= c %>"><%= settings.api.client.coins.store.cpu.per/100 * c %> Cores &mdash; <%= settings.api.client.coins.store.cpu.cost * c %> coin<%= (settings.api.client.coins.store.cpu.cost * c) == 1 ? "" : "s" %></option>
                <% } %>
              </select>
              <button onclick="buyCPU()" class="w-full inline-flex items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 transition-colors">Purchase CPU</button>
            </div>

            <!-- Disk card -->
            <div class="bg-white border border-gray-200/60 rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center mb-4">
                <div class="bg-emerald-50 text-emerald-600 rounded-xl p-2.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Z" /></svg></div>
                <h3 class="ml-3 text-base font-semibold text-gray-900">Storage</h3>
              </div>
              <p class="text-xs text-gray-500 mb-4"><%= settings.api.client.coins.store.disk.per/1024 %> GiB per <%= settings.api.client.coins.store.disk.cost %> coin<%= settings.api.client.coins.store.disk.cost == 1 ? "" : "s" %></p>
              <select id="disk" class="w-full mb-3 px-4 py-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:border-emerald-400 focus:ring-emerald-500 text-gray-700">
                <% for (let d = 1; d <= 10; d++) { %>
                <option value="<%= d %>"><%= settings.api.client.coins.store.disk.per/1024 * d %> GiB &mdash; <%= settings.api.client.coins.store.disk.cost * d %> coin<%= (settings.api.client.coins.store.disk.cost * d) == 1 ? "" : "s" %></option>
                <% } %>
              </select>
              <button onclick="buyDisk()" class="w-full inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors">Purchase Storage</button>
            </div>

            <!-- Servers card -->
            <div class="bg-white border border-gray-200/60 rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center mb-4">
                <div class="bg-amber-50 text-amber-600 rounded-xl p-2.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 17.25v-.228a4.5 4.5 0 0 0-.12-1.03l-2.268-9.64a3.375 3.375 0 0 0-3.285-2.602H7.923a3.375 3.375 0 0 0-3.285 2.602l-2.268 9.64a4.5 4.5 0 0 0-.12 1.03v.228m19.5 0a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3m19.5 0a3 3 0 0 0-3-3H5.25a3 3 0 0 0-3 3" /></svg></div>
                <h3 class="ml-3 text-base font-semibold text-gray-900">Server Slots</h3>
              </div>
              <p class="text-xs text-gray-500 mb-4"><%= settings.api.client.coins.store.servers.per %> slot(s) per <%= settings.api.client.coins.store.servers.cost %> coin<%= settings.api.client.coins.store.servers.cost == 1 ? "" : "s" %></p>
              <select id="servers" class="w-full mb-3 px-4 py-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:border-amber-400 focus:ring-amber-500 text-gray-700">
                <% for (let s = 1; s <= 10; s++) { %>
                <option value="<%= s %>"><%= settings.api.client.coins.store.servers.per * s %> Slots &mdash; <%= settings.api.client.coins.store.servers.cost * s %> coin<%= (settings.api.client.coins.store.servers.cost * s) == 1 ? "" : "s" %></option>
                <% } %>
              </select>
              <button onclick="buyServers()" class="w-full inline-flex items-center justify-center rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-700 transition-colors">Purchase Slots</button>
            </div>

          </div>

          <script>
            function buyRAM(){ document.location.href = `/buy?type=ram&amount=${encodeURIComponent(document.getElementById('ram').value)}&token=<%= csrfToken %>`; }
            function buyCPU(){ document.location.href = `/buy?type=cpu&amount=${encodeURIComponent(document.getElementById('cpu').value)}&token=<%= csrfToken %>`; }
            function buyDisk(){ document.location.href = `/buy?type=disk&amount=${encodeURIComponent(document.getElementById('disk').value)}&token=<%= csrfToken %>`; }
            function buyServers(){ document.location.href = `/buy?type=servers&amount=${encodeURIComponent(document.getElementById('servers').value)}&token=<%= csrfToken %>`; }
          </script>

        </div>
      </div>
    </main>
    <%- include('../components/footer') %>
  </div>
</body>
