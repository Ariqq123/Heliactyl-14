<%- include("../layouts/head") %>

<%- include("../components/page-hero", {
  icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path d="M9.375 3a1.875 1.875 0 0 0 0 3.75h1.875v4.5H3.375A1.875 1.875 0 0 1 1.5 9.375v-.75c0-1.036.84-1.875 1.875-1.875h3.193A3.375 3.375 0 0 1 12 2.753a3.375 3.375 0 0 1 5.432 3.997h3.943c1.035 0 1.875.84 1.875 1.875v.75c0 1.036-.84 1.875-1.875 1.875H12.75v-4.5h1.875a1.875 1.875 0 1 0-1.875-1.875V6.75h-1.5V4.875C11.25 3.839 10.41 3 9.375 3ZM11.25 12.75H3v6.75a2.25 2.25 0 0 0 2.25 2.25h6v-9ZM12.75 12.75v9h6.75a2.25 2.25 0 0 0 2.25-2.25v-6.75h-9Z" /></svg>',
  iconClass: 'bg-violet-50 dark:bg-violet-950 border border-violet-100/50 dark:border-violet-800/50 text-violet-500 dark:text-violet-400',
  gradient: 'from-violet-50 to-purple-100',
  title: 'AFK Earnings',
  subtitle: 'Leave this tab open and collect coins automatically.',
  action: false
}) %>

          <!-- Turnstile gate -->
          <% if (settings.turnstile && settings.turnstile.enabled) { %>
          <div id="afk-gate" class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-3xl p-8 shadow-sm mb-6">
            <div class="flex items-center mb-4">
              <div class="bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-400 rounded-xl p-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                </svg>
              </div>
              <h3 class="ml-3 text-base font-semibold text-gray-900 dark:text-slate-100">Verify you're human</h3>
            </div>
            <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Complete the verification below to start earning coins.</p>
            <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
            <div class="cf-turnstile" data-sitekey="<%= settings.turnstile.siteKey %>" data-callback="onTurnstileSuccess"></div>
            <p id="afk-gate-status" class="text-xs text-gray-400 dark:text-slate-500 mt-4">Waiting for verification...</p>
          </div>
          <div id="afk-stats" class="hidden">
          <% } else { %>
          <div id="afk-stats">
          <% } %>

            <!-- Stats grid -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-3xl p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500 dark:text-slate-400 flex items-center"><span class="w-2 h-2 rounded-full bg-blue-500 mr-2"></span>Countdown</p>
                <p class="mt-2 text-3xl font-bold text-gray-900 dark:text-slate-100"><span id="arciotimer">-</span><span class="text-base font-medium text-gray-400 dark:text-slate-500 ml-1">s</span></p>
              </div>
              <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-3xl p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500 dark:text-slate-400 flex items-center"><span class="w-2 h-2 rounded-full bg-amber-500 mr-2"></span>Earnings</p>
                <p class="mt-2 text-3xl font-bold text-gray-900 dark:text-slate-100"><span id="arciogainedcoins">0</span><span class="text-base font-medium text-gray-400 dark:text-slate-500 ml-1">coins</span></p>
              </div>
              <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-3xl p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500 dark:text-slate-400 flex items-center"><span class="w-2 h-2 rounded-full bg-violet-500 mr-2"></span>Session</p>
                <p class="mt-2 text-3xl font-bold text-gray-900 dark:text-slate-100"><span id="sessionDuration">-</span></p>
              </div>
            </div>

            <p class="mt-6 text-xs text-gray-400 dark:text-slate-500 text-center">Keep this tab visible to keep earning. Closing it ends the session.</p>
          </div>

          <script>
            <% if (settings.turnstile && settings.turnstile.enabled) { %>
            window.__turnstileToken = null;
            window.onTurnstileSuccess = function(token) {
              window.__turnstileToken = token;
              document.getElementById('afk-gate').classList.add('hidden');
              document.getElementById('afk-stats').classList.remove('hidden');
              document.getElementById('afk-gate-status').textContent = 'Verified, connecting...';
              startAfkSession();
            };
            function startAfkSession() {
              <%- arcioafktext %>
            }
            <% } else { %>
            <%- arcioafktext %>
            <% } %>
          </script>
<%- include("../layouts/tail") %>
