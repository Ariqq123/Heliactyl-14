<%- include('../layouts/base-head') %>

<body class="bg-gray-100 dark:bg-slate-900 flex h-screen overflow-x-hidden" style="font-family: 'Inter', sans-serif;">
  <%- include('../components/navigation') %>
  <div class="flex-1 min-w-0 flex flex-col h-screen overflow-y-auto">
    <main class="flex-1 pb-32">
      <div class="py-6">
        <%- include('../components/skeleton') %>
        <div class="hidden max-w-7xl pt-8 mx-auto px-4 sm:px-6 md:px-8" id="content">
          <div class="relative overflow-hidden bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700/60 dark:border-slate-700 rounded-3xl mb-8 p-8 shadow-sm">
            <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-gradient-to-br from-rose-50 to-orange-100 dark:from-slate-800 dark:to-slate-700 opacity-50 blur-3xl"></div>
            <div class="relative flex items-center">
              <div class="bg-rose-50 dark:bg-rose-950 border border-rose-100/50 dark:border-rose-800/50 rounded-2xl h-14 w-14 flex items-center justify-center text-rose-500 dark:text-rose-400 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-5">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-slate-200 tracking-tight">Security</h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Review your panel credentials and reveal the generated password when needed.</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            <div class="lg:col-span-2 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700/60 dark:border-slate-700 rounded-3xl p-8 shadow-sm">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Panel credentials</h3>
              <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">These credentials are tied to your Heliactyl session.</p>
              <dl class="mt-6 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between rounded-2xl bg-gray-50 dark:bg-slate-800 px-5 py-4 gap-2">
                  <dt class="text-sm font-medium text-gray-700 dark:text-slate-300">Username</dt>
                  <dd><span class="inline-flex rounded-full bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 px-4 py-2 text-sm text-gray-700 dark:text-slate-300"><%= pterodactyl.username %></span></dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between rounded-2xl bg-gray-50 dark:bg-slate-800 px-5 py-4 gap-2">
                  <dt class="text-sm font-medium text-gray-700 dark:text-slate-300">Email</dt>
                  <dd><span class="inline-flex rounded-full bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 px-4 py-2 text-sm text-gray-700 dark:text-slate-300 break-all"><%= pterodactyl.email %></span></dd>
                </div>
                <div class="rounded-2xl bg-gray-50 dark:bg-slate-800 px-5 py-4">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div>
                      <dt class="text-sm font-medium text-gray-700 dark:text-slate-300">Password</dt>
                      <dd class="mt-2 text-sm text-gray-600 dark:text-slate-400 font-mono">
                        <% if (req.session.password) { %>
                        <span><%= req.session.password %></span>
                        <% } else { %>
                        <span>*************</span>
                        <% } %>
                      </dd>
                      <p class="mt-2 text-xs text-gray-500 dark:text-slate-400">Tip: If you only need to access the panel, use <a href="../panel" class="text-indigo-600 hover:text-indigo-700 font-medium">Open Panel</a> to automatically log in without needing your password.</p>
                    </div>
                    <div>
                      <% if (req.session.password) { %>
                      <a href="../security" class="inline-flex items-center rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2 text-sm font-medium text-gray-600 dark:text-slate-400 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">Hide Password</a>
                      <% } else { %>
                      <a href="../regen?token=<%= csrfToken %>" class="inline-flex items-center rounded-xl bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700 transition-colors">Show Password</a>
                      <% } %>
                    </div>
                  </div>
                </div>
              </dl>
            </div>

            <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-3xl p-8 shadow-sm h-fit">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Security tips</h3>
              <ul class="mt-4 space-y-3 text-sm text-gray-500 dark:text-slate-400">
                <li class="rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-200/60 dark:border-slate-700 px-4 py-3">Keep your panel password private.</li>
                <li class="rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-200/60 dark:border-slate-700 px-4 py-3">Refresh credentials if you suspect exposure.</li>
                <li class="rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-200/60 dark:border-slate-700 px-4 py-3">Do not share panel access with untrusted users.</li>
              </ul>
            </div>
          </div>

          <!-- Danger Zone -->
          <div x-data="{ showModal: false, confirmText: '', error: '' }" class="mt-8 bg-rose-50 dark:bg-rose-950/50 border-2 border-rose-200 dark:border-rose-800 rounded-3xl p-8 shadow-sm">
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-rose-600">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
              </div>
              <div class="ml-4 flex-1">
                <h3 class="text-lg font-bold text-rose-900 dark:text-rose-200">Danger Zone</h3>
                <p class="mt-2 text-sm text-rose-700 dark:text-rose-300">Permanently delete your account and all associated data. This action cannot be undone.</p>
                <div class="mt-4 bg-white dark:bg-slate-900 border border-rose-200 dark:border-rose-800 rounded-2xl p-4">
                  <h4 class="text-sm font-semibold text-rose-900 dark:text-rose-200 mb-2">What will be deleted:</h4>
                  <ul class="text-xs text-rose-700 dark:text-rose-300 space-y-1 list-disc list-inside">
                    <li>Your Heliactyl account and login access</li>
                    <li>All coins and purchased resources</li>
                    <li>Package and extra resource allocations</li>
                    <li>Account linking to Discord</li>
                  </ul>
                  <p class="text-xs text-rose-600 dark:text-rose-400 mt-3 font-medium">Note: Your servers on the Pterodactyl panel will remain, but you will lose dashboard access.</p>
                </div>
                <div class="mt-6">
                  <button x-on:click="showModal = true; confirmText = ''; error = ''" class="inline-flex items-center rounded-xl bg-rose-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-rose-700 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                    Delete My Account
                  </button>
                </div>
              </div>
            </div>

            <!-- Delete confirmation modal -->
            <div x-show="showModal" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 z-50 flex items-center justify-center p-4" style="display: none;">
              <div class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm" x-on:click="showModal = false"></div>
              <div x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95" class="relative bg-white dark:bg-slate-900 rounded-3xl shadow-xl max-w-md w-full p-8 border border-gray-200 dark:border-slate-700">
                <div class="flex items-center mb-4">
                  <div class="bg-rose-100 dark:bg-rose-950 rounded-xl p-2.5">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-rose-600 dark:text-rose-400">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                  </div>
                  <h3 class="ml-3 text-lg font-bold text-gray-900 dark:text-slate-100">Confirm Account Deletion</h3>
                </div>
                <p class="text-sm text-gray-600 dark:text-slate-400 mb-4">This is permanent and cannot be undone. You will lose all coins, resources, and dashboard access.</p>
                <label class="text-sm font-medium text-gray-700 dark:text-slate-300">Type <span class="font-mono font-bold text-rose-600">DELETE</span> to confirm</label>
                <input type="text" x-model="confirmText" x-on:keydown.enter="
                  if (confirmText === 'DELETE') window.location.href = '/delete_my_account?token=<%= csrfToken %>';
                  else error = 'Text does not match. Type DELETE exactly.';
                " placeholder="DELETE" class="mt-2 w-full rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-3 text-sm text-gray-700 dark:text-slate-300 shadow-sm focus:border-rose-400 focus:ring-rose-500 placeholder:text-gray-300 dark:placeholder:text-slate-600">
                <p x-show="error" x-text="error" class="mt-2 text-xs text-rose-600 dark:text-rose-400"></p>
                <div class="mt-6 flex gap-3">
                  <button x-on:click="
                    if (confirmText === 'DELETE') window.location.href = '/delete_my_account?token=<%= csrfToken %>';
                    else error = 'Text does not match. Type DELETE exactly.';
                  " class="flex-1 inline-flex items-center justify-center rounded-xl bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-rose-700 transition-colors">Delete Permanently</button>
                  <button x-on:click="showModal = false" class="flex-1 inline-flex items-center justify-center rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-medium text-gray-600 dark:text-slate-400 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">Cancel</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <%- include('../components/footer') %>
  </div>
</body>
</html>
