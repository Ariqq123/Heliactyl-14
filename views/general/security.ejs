<head>
  <title><%= settings.name %></title>
  <link rel="icon" type="image/x-icon" href="../assets/favicon.png">
  <link rel="stylesheet" href="../assets/tailwind.css">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://unpkg.com/@popperjs/core@2.10.1/dist/umd/popper.min.js"></script>
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-gray-100 flex h-screen overflow-x-hidden" style="font-family: 'Inter', sans-serif;">
  <%- include('../components/navigation') %>
  <div class="flex-1 min-w-0 flex flex-col h-screen overflow-y-auto">
    <main class="flex-1 pb-32">
      <div class="py-6">
        <%- include('../components/skeleton') %>
        <div class="hidden max-w-7xl pt-8 mx-auto px-4 sm:px-6 md:px-8" id="content">
          <div class="relative overflow-hidden bg-white border border-gray-200/60 rounded-3xl mb-8 p-8 shadow-sm">
            <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-gradient-to-br from-rose-50 to-orange-100 opacity-50 blur-3xl"></div>
            <div class="relative flex items-center">
              <div class="bg-rose-50 border border-rose-100/50 rounded-2xl h-14 w-14 flex items-center justify-center text-rose-500 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                  <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25Zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-5">
                <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Security</h2>
                <p class="mt-1 text-sm text-gray-500">Review your panel credentials and reveal the generated password when needed.</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            <div class="lg:col-span-2 bg-white border border-gray-200/60 rounded-3xl p-8 shadow-sm">
              <h3 class="text-lg font-semibold text-gray-900">Panel credentials</h3>
              <p class="mt-1 text-sm text-gray-500">These credentials are tied to your Heliactyl session.</p>
              <dl class="mt-6 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between rounded-2xl bg-gray-50 px-5 py-4 gap-2">
                  <dt class="text-sm font-medium text-gray-700">Username</dt>
                  <dd><span class="inline-flex rounded-full bg-white border border-gray-200 px-4 py-2 text-sm text-gray-700"><%= pterodactyl.username %></span></dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between rounded-2xl bg-gray-50 px-5 py-4 gap-2">
                  <dt class="text-sm font-medium text-gray-700">Email</dt>
                  <dd><span class="inline-flex rounded-full bg-white border border-gray-200 px-4 py-2 text-sm text-gray-700 break-all"><%= pterodactyl.email %></span></dd>
                </div>
                <div class="rounded-2xl bg-gray-50 px-5 py-4">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div>
                      <dt class="text-sm font-medium text-gray-700">Password</dt>
                      <dd class="mt-2 text-sm text-gray-600 font-mono">
                        <% if (req.session.password) { %>
                        <span><%= req.session.password %></span>
                        <% } else { %>
                        <span>*************</span>
                        <% } %>
                      </dd>
                    </div>
                    <div>
                      <% if (req.session.password) { %>
                      <a href="../security" class="inline-flex items-center rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">Hide Password</a>
                      <% } else { %>
                      <a href="../regen" class="inline-flex items-center rounded-xl bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700 transition-colors">Show Password</a>
                      <% } %>
                    </div>
                  </div>
                </div>
              </dl>
            </div>

            <div class="bg-white border border-gray-200/60 rounded-3xl p-8 shadow-sm h-fit">
              <h3 class="text-lg font-semibold text-gray-900">Security tips</h3>
              <ul class="mt-4 space-y-3 text-sm text-gray-500">
                <li class="rounded-2xl bg-gray-50 px-4 py-3">Keep your panel password private.</li>
                <li class="rounded-2xl bg-gray-50 px-4 py-3">Refresh credentials if you suspect exposure.</li>
                <li class="rounded-2xl bg-gray-50 px-4 py-3">Do not share panel access with untrusted users.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </main>
    <%- include('../components/footer') %>
  </div>
</body>
