<%- include('../layouts/base-head') %>

<body class="bg-gray-100 dark:bg-slate-900 flex h-screen overflow-x-hidden" style="font-family: 'Inter', sans-serif;">
  <%- include('../components/navigation') %>
  <div class="flex-1 min-w-0 flex flex-col h-screen overflow-y-auto">
    <main class="flex-1 pb-32">
      <div class="py-6">
        <%- include('../components/skeleton') %>
        <div class="hidden max-w-7xl pt-8 mx-auto px-4 sm:px-6 md:px-8" id="content">
          <div class="overflow-hidden rounded-3xl border border-gray-200 dark:border-slate-700/60 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm">
            <div class="relative h-44 sm:h-64">
              <img class="h-full w-full object-cover" src="../assets/profileBanner.png" alt="">
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            </div>
            <div class="px-6 sm:px-8 pb-8">
              <div class="-mt-16 sm:-mt-20 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5">
                <div class="flex items-end gap-4">
                  <img class="h-24 w-24 sm:h-32 sm:w-32 rounded-3xl ring-4 ring-white shadow-lg" src="<%= userinfo.avatar ? `https://cdn.discordapp.com/avatars/${userinfo.id}/${userinfo.avatar}?size=256` : `https://cdn.discordapp.com/embed/avatars/${parseInt(userinfo.id) % 6}.png` %>" alt="">
                  <div class="pb-2">
                    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100"><%= userinfo.global_name %></h1>
                    <p class="text-sm text-gray-500 dark:text-slate-400">@<%= userinfo.username %></p>
                  </div>
                </div>
                <a href="../updateinfo?token=<%= csrfToken %>" class="inline-flex items-center rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 mr-2 h-4 w-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                  </svg>
                  Refresh Profile
                </a>
              </div>
            </div>
          </div>

          <!-- Account Summary -->
          <div class="mt-8">
            <h3 class="text-sm font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-4 px-1">Account Summary</h3>
            <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
              <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
                <dt class="text-sm font-medium text-gray-500 dark:text-slate-400 flex items-center">
                  <div class="w-2 h-2 rounded-full bg-amber-500 mr-2"></div>Coins
                </dt>
                <dd class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100"><%= (coins || 0).toFixed(2) %></dd>
              </div>
              <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
                <dt class="text-sm font-medium text-gray-500 dark:text-slate-400 flex items-center">
                  <div class="w-2 h-2 rounded-full bg-indigo-500 mr-2"></div>Package
                </dt>
                <dd class="mt-3 text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-100"><%= (packages && packages.displayName ? packages.displayName : packagename) %></dd>
              </div>
              <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
                <dt class="text-sm font-medium text-gray-500 dark:text-slate-400 flex items-center">
                  <div class="w-2 h-2 rounded-full bg-emerald-500 mr-2"></div>Servers
                </dt>
                <dd class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-100"><%= pterodactyl.relationships.servers.data.length %></dd>
              </div>
              <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
                <dt class="text-sm font-medium text-gray-500 dark:text-slate-400 flex items-center">
                  <div class="w-2 h-2 rounded-full bg-blue-500 mr-2"></div>Member Since
                </dt>
                <dd class="mt-3 text-lg font-bold tracking-tight text-gray-900 dark:text-slate-100">
                  <% const snowflake = BigInt(userinfo.id); const discordEpoch = 1420070400000; const createdAt = new Date(Number(snowflake >> 22n) + discordEpoch); %>
                  <%= createdAt.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
                </dd>
              </div>
            </dl>
          </div>

          <!-- Linked Accounts -->
          <div class="mt-8">
            <h3 class="text-sm font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-4 px-1">Linked Accounts</h3>
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
              <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
                <div class="flex items-center mb-4">
                  <div class="bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 rounded-xl p-2.5">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
                  </div>
                  <h4 class="ml-3 text-base font-semibold text-gray-900 dark:text-slate-100">Discord</h4>
                </div>
                <dl class="space-y-3">
                  <div class="flex justify-between items-center">
                    <dt class="text-sm text-gray-500 dark:text-slate-400">Username</dt>
                    <dd class="text-sm font-medium text-gray-900 dark:text-slate-100">@<%= userinfo.username %></dd>
                  </div>
                  <div class="flex justify-between items-center">
                    <dt class="text-sm text-gray-500 dark:text-slate-400">Display Name</dt>
                    <dd class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= userinfo.global_name || userinfo.username %></dd>
                  </div>
                  <div class="flex justify-between items-center">
                    <dt class="text-sm text-gray-500 dark:text-slate-400">ID</dt>
                    <dd class="text-sm font-mono text-gray-600 dark:text-slate-400"><%= userinfo.id %></dd>
                  </div>
                  <div class="flex justify-between items-center">
                    <dt class="text-sm text-gray-500 dark:text-slate-400">Email</dt>
                    <dd class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= userinfo.email || 'Not available' %></dd>
                  </div>
                </dl>
              </div>
              <div class="bg-white dark:bg-slate-800 border border-gray-200/60 dark:border-slate-700 rounded-2xl p-6 shadow-sm">
                <div class="flex items-center mb-4">
                  <div class="bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 rounded-xl p-2.5">
                    <svg class="w-5 h-5" viewBox="0 0 256 256" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M128 0C57.308 0 0 57.308 0 128s57.308 128 128 128 128-57.308 128-128S198.692 0 128 0zm67.401 167.358c-10.049 9.963-24.295 15.588-38.19 18.489-14.208 2.966-28.916 3.476-43.396 2.627-13.553-.795-27.063-2.97-39.98-7.157-6.12-1.984-12.073-4.476-17.456-7.93-2.545-1.633-4.95-3.52-6.83-5.88-1.926-2.418-3.2-5.37-3.2-8.44 0-2.418.7-4.79 1.88-6.89 1.157-2.06 2.74-3.84 4.52-5.36 3.56-3.04 7.78-5.16 12.08-6.84 9.12-3.56 18.8-5.56 28.52-6.84-5.04-3.08-9.56-6.96-13.16-11.56-4.04-5.16-6.88-11.2-8.04-17.6-1.2-6.6-.6-13.56 1.84-19.84 2.36-6.08 6.4-11.44 11.44-15.44 5.16-4.1 11.24-6.76 17.6-8.24 6.52-1.52 13.32-1.84 19.96-1.2 6.44.62 12.84 2.16 18.68 4.92 5.64 2.66 10.76 6.48 14.68 11.36 4.04 5.04 6.72 11.12 7.72 17.56 1.04 6.64.36 13.52-1.88 19.84-2.2 6.2-5.92 11.8-10.6 16.32-4.52 4.36-9.88 7.72-15.6 10.16 8.28.84 16.52 2.36 24.44 4.92 5.92 1.92 11.68 4.44 16.6 8.12 2.4 1.8 4.6 3.88 6.24 6.4 1.68 2.6 2.68 5.6 2.68 8.72 0 3.48-1.36 6.72-3.52 9.44z"/></svg>
                  </div>
                  <h4 class="ml-3 text-base font-semibold text-gray-900 dark:text-slate-100">Pterodactyl</h4>
                </div>
                <dl class="space-y-3">
                  <div class="flex justify-between items-center">
                    <dt class="text-sm text-gray-500 dark:text-slate-400">Panel ID</dt>
                    <dd class="text-sm font-mono text-gray-600 dark:text-slate-400"><%= pterodactyl.id || '—' %></dd>
                  </div>
                  <div class="flex justify-between items-center">
                    <dt class="text-sm text-gray-500 dark:text-slate-400">Username</dt>
                    <dd class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= pterodactyl.username || '—' %></dd>
                  </div>
                  <div class="flex justify-between items-center">
                    <dt class="text-sm text-gray-500 dark:text-slate-400">Email</dt>
                    <dd class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= pterodactyl.email || '—' %></dd>
                  </div>
                  <div class="flex justify-between items-center">
                    <dt class="text-sm text-gray-500 dark:text-slate-400">Admin</dt>
                    <dd class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= pterodactyl.admin ? 'Yes' : 'No' %></dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <%- include('../components/footer') %>
  </div>
</body>
