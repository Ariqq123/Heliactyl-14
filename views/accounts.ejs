<%- include('./layouts/base-head') %>
<style>
  body { font-family: 'Inter', sans-serif; }
  .bg-grid-pattern { background-image: radial-gradient(circle at 1px 1px, rgb(203 213 225 / 0.4) 1px, transparent 0); background-size: 24px 24px; }
</style>
<body class="h-full bg-slate-50 dark:bg-slate-900 antialiased">
  <div class="flex min-h-full">
    <div class="flex flex-1 flex-col justify-center px-6 py-12 lg:flex-none lg:w-[500px] xl:w-[540px] bg-white dark:bg-slate-900 border-r border-slate-100 relative overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern pointer-events-none"></div>
      <div class="absolute -top-24 -left-24 w-72 h-72 bg-indigo-100 rounded-full blur-3xl opacity-40 pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-64 h-64 bg-violet-100 rounded-full blur-3xl opacity-30 pointer-events-none"></div>

      <div class="relative mx-auto w-full max-w-md">
        <div class="flex items-center gap-3 mb-12">
          <div class="bg-indigo-600 rounded-xl w-9 h-9 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="white" class="w-5 h-5">
              <path d="m3.196 12.87-.825.483a.75.75 0 0 0 0 1.294l7.25 4.25a.75.75 0 0 0 .758 0l7.25-4.25a.75.75 0 0 0 0-1.294l-.825-.484-5.666 3.322a2.25 2.25 0 0 1-2.276 0L3.196 12.87Z" />
              <path d="m3.196 8.87-.825.483a.75.75 0 0 0 0 1.294l7.25 4.25a.75.75 0 0 0 .758 0l7.25-4.25a.75.75 0 0 0 0-1.294l-.825-.484-5.666 3.322a2.25 2.25 0 0 1-2.276 0L3.196 8.87Z" />
              <path d="M10.38 1.103a.75.75 0 0 0-.76 0l-7.25 4.25a.75.75 0 0 0 0 1.294l7.25 4.25a.75.75 0 0 0 .76 0l7.25-4.25a.75.75 0 0 0 0-1.294l-7.25-4.25Z" />
            </svg>
          </div>
          <span class="text-slate-800 text-xl font-bold tracking-tight"><%= settings.name %></span>
        </div>

        <div class="mb-10">
          <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Choose an account.</h1>
          <p class="mt-2 text-base text-slate-500">Select which identity you want to use in the dashboard.</p>
        </div>

        <div class="space-y-4">
          <a href="../dashboard" class="group flex items-center justify-between rounded-3xl border border-slate-200 bg-white dark:bg-slate-900 px-5 py-4 shadow-sm hover:border-indigo-300 hover:bg-indigo-50 dark:bg-indigo-950/40 transition-all">
            <div class="flex items-center min-w-0">
              <img class="h-12 w-12 rounded-2xl border border-slate-200 mr-4" src="<%= userinfo.avatar ? `https://cdn.discordapp.com/avatars/${userinfo.id}/${userinfo.avatar}?size=256` : `https://cdn.discordapp.com/embed/avatars/${parseInt(userinfo.id) % 6}.png` %>" alt="">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-900 truncate"><%= req.session.userinfo.global_name %></p>
                <p class="text-xs text-slate-500 truncate">@<%= req.session.userinfo.username %></p>
              </div>
            </div>
            <div class="inline-flex items-center text-indigo-600 text-sm font-semibold group-hover:translate-x-0.5 transition-transform">
              Continue
            </div>
          </a>

          <a href="../login" class="group flex items-center justify-center rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-5 py-4 text-sm font-semibold text-slate-600 hover:border-indigo-300 hover:bg-indigo-50 dark:bg-indigo-950/40 hover:text-indigo-700 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 mr-2">
              <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
            </svg>
            Add another account
          </a>
        </div>
      </div>
    </div>

    <div class="relative hidden lg:flex flex-1 items-end overflow-hidden bg-slate-900">
      <img class="absolute inset-0 h-full w-full object-cover opacity-40" src="../assets/loginBackground.png" alt="">
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-900/80 via-slate-900/60 to-slate-900/90"></div>
      <div class="relative z-10 p-12 pb-16 w-full">
        <h2 class="text-4xl font-extrabold text-white tracking-tight leading-snug mb-4">One dashboard,<br><span class="text-indigo-300">multiple identities.</span></h2>
        <p class="text-slate-300 text-base max-w-md leading-relaxed">Switch accounts quickly and jump back into your servers, quotas, and security settings.</p>
      </div>
    </div>
  </div>
</body>
</html>
