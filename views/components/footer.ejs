<footer class="mt-auto bg-transparent py-4">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
    <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700/60 dark:border-slate-700 rounded-2xl shadow-sm px-5 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-gray-500 dark:text-slate-400">
      <p class="font-medium text-gray-600 dark:text-slate-400">&copy; <span id="footerYear"></span> <%= settings.name %>. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-2 font-light">
        <span>Powered by</span>
        <a class="font-medium text-gray-700 dark:text-slate-300 hover:text-indigo-600 transition" href="https://github.com/heliactyloss/heliactyl">Heliactyl</a>
        <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700/70 px-2.5 py-0.5 font-mono text-[11px] text-gray-600 dark:text-slate-400">v<%= settings.version %></span>
        <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700/70 px-2.5 py-0.5 font-mono text-[11px] text-gray-600 dark:text-slate-400" id="loadingTime">…</span>
      </div>
    </div>
  </div>
</footer>
<script>
  (function () {
    document.getElementById('footerYear').textContent = new Date().getFullYear();
    var startedAt = window.__pageStartedAt || performance.timing.navigationStart || Date.now();
    var loadEl = document.getElementById('loadingTime');
    function paintLoadTime() {
      var t = (Date.now() - startedAt) / 1000;
      if (loadEl) loadEl.textContent = t.toFixed(2) + 's';
    }
    if (document.readyState === 'complete') paintLoadTime();
    else window.addEventListener('load', paintLoadTime);
  })();
</script>
