<% if (type === 'success') { %>
<div class="rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 p-6 mb-6">
  <div class="flex">
    <svg class="h-6 w-6 text-emerald-500 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
    <div class="ml-3">
      <h3 class="text-sm font-medium text-emerald-800 dark:text-emerald-200"><%= title %></h3>
      <% if (typeof message !== 'undefined' && message) { %><p class="mt-1 text-sm text-emerald-700 dark:text-emerald-300"><%= message %></p><% } %>
    </div>
  </div>
</div>
<script>window.dispatchEvent(new CustomEvent('toast', { detail: { type: 'success', title: '<%= title %>', message: '<%= typeof message !== "undefined" ? message : "" %>' } }));</script>
<% } else { %>
<div class="rounded-2xl bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800 p-6 mb-6">
  <div class="flex">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-rose-500 flex-shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    <div class="ml-3">
      <h3 class="text-sm font-medium text-rose-800 dark:text-rose-200"><%= title %></h3>
      <% if (typeof message !== 'undefined' && message) { %><p class="mt-1 text-sm text-rose-700 dark:text-rose-300"><%= message %></p><% } %>
    </div>
  </div>
</div>
<script>window.dispatchEvent(new CustomEvent('toast', { detail: { type: 'error', title: '<%= title %>', message: '<%= typeof message !== "undefined" ? message : "" %>' } }));</script>
<% } %>
