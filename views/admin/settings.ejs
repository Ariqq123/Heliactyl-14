<%- include("../layouts/head") %>

<%- include("../components/page-hero", {
  icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path fill-rule="evenodd" d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 0 0-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 0 0-2.282.819l-.922 1.597a1.875 1.875 0 0 0 .432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 0 0 0 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 0 0-.432 2.385l.922 1.597a1.875 1.875 0 0 0 2.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 0 0 2.28-.819l.923-1.597a1.875 1.875 0 0 0-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 0 0 0-1.139c-.016-.2.059-.352.153-.43l.84-.692c.708-.582.891-1.59.433-2.385l-.922-1.597a1.875 1.875 0 0 0-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.083a7.49 7.49 0 0 0-.985-.57c-.183-.087-.277-.227-.297-.348l-.179-1.072a1.875 1.875 0 0 0-1.85-1.567h-1.843ZM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z" clip-rule="evenodd" /></svg>',
  iconClass: 'bg-indigo-50 border border-indigo-100/50 text-indigo-500',
  gradient: 'from-indigo-50 to-blue-100',
  title: 'System Settings',
  subtitle: 'Modify global parameters directly from the dashboard.',
  action: '<a href="/admin" class="inline-flex items-center rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>Back to Admin Tools</a>'
}) %>

          <!-- Alert -->
          <% if (req.query.err && req.query.err !== "none") { %>
          <div class="rounded-2xl bg-rose-50 border border-rose-200 p-6 mb-6">
            <div class="flex">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-rose-500 flex-shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-rose-800">An error was encountered</h3>
                <p class="mt-1 text-sm text-rose-700">Error code: <code><%= req.query.err %></code></p>
              </div>
            </div>
          </div>
          <% } %>
          <% if (req.query.err && req.query.err == "none") { %>
          <div class="rounded-2xl bg-emerald-50 border border-emerald-200 p-6 mb-6">
            <div class="flex">
              <svg class="h-6 w-6 text-emerald-500 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
              <div class="ml-3"><h3 class="text-sm font-medium text-emerald-800">Settings update successful!</h3><p class="mt-1 text-sm text-emerald-700">Your settings.json file has been updated. You may need to reboot Heliactyl to apply changes.</p></div>
            </div>
          </div>
          <% } %>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Pterodactyl config -->
            <div class="bg-white border border-gray-200/60 rounded-3xl p-8 shadow-sm">
              <div class="flex items-center mb-5">
                <div class="bg-indigo-50 text-indigo-600 rounded-xl p-2.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 17.25v-.228a4.5 4.5 0 0 0-.12-1.03l-2.268-9.64a3.375 3.375 0 0 0-3.285-2.602H7.923a3.375 3.375 0 0 0-3.285 2.602l-2.268 9.64a4.5 4.5 0 0 0-.12 1.03v.228m19.5 0a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3m19.5 0a3 3 0 0 0-3-3H5.25a3 3 0 0 0-3 3m16.5 0h.008v.008h-.008v-.008Zm-3 0h.008v.008h-.008v-.008Z" /></svg></div>
                <h3 class="ml-3 text-lg font-semibold text-gray-900">Pterodactyl Interface</h3>
              </div>
              <div class="space-y-4">
                <div>
                  <label class="text-sm font-medium text-gray-700">Panel URL <span class="text-xs text-gray-400 font-normal">(hostname only)</span></label>
                  <input type="text" id="url" placeholder="example.com" class="mt-2 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-sm focus:border-indigo-400 focus:ring-indigo-500 placeholder:text-gray-400">
                </div>
                <div>
                  <label class="text-sm font-medium text-gray-700">Application API Key</label>
                  <input type="password" id="key" placeholder="ptla_xxx" class="mt-2 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-sm focus:border-indigo-400 focus:ring-indigo-500 placeholder:text-gray-400">
                </div>
              </div>
              <button onclick="updatePtero()" class="mt-6 inline-flex items-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors">Save Interface Settings</button>
            </div>

            <!-- OAuth2 config -->
            <div class="bg-white border border-gray-200/60 rounded-3xl p-8 shadow-sm">
              <div class="flex items-center mb-5">
                <div class="bg-amber-50 text-amber-600 rounded-xl p-2.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg></div>
                <h3 class="ml-3 text-lg font-semibold text-gray-900">Discord OAuth2</h3>
              </div>
              <div class="space-y-4">
                <div>
                  <label class="text-sm font-medium text-gray-700">Client ID</label>
                  <input type="text" id="cID" placeholder="1234567890" class="mt-2 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-sm focus:border-amber-400 focus:ring-amber-500 placeholder:text-gray-400">
                </div>
                <div>
                  <label class="text-sm font-medium text-gray-700">Client Secret</label>
                  <input type="password" id="cSecret" placeholder="secret_xxx" class="mt-2 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-sm focus:border-amber-400 focus:ring-amber-500 placeholder:text-gray-400">
                </div>
                <div>
                  <label class="text-sm font-medium text-gray-700">Callback URL <span class="text-xs text-gray-400 font-normal">(hostname only)</span></label>
                  <input type="text" id="callbackUrl" placeholder="example.com" class="mt-2 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-sm focus:border-amber-400 focus:ring-amber-500 placeholder:text-gray-400">
                </div>
              </div>
              <button onclick="updateOAuth2()" class="mt-6 inline-flex items-center rounded-xl bg-amber-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-700 transition-colors">Save Auth Settings</button>
            </div>

          </div>

          <script>
            const __csrf = "<%= csrfToken %>";
            function updatePtero() {
              const url = document.getElementById('url').value.startsWith('http') ? document.getElementById('url').value : 'https://' + document.getElementById('url').value;
              const key = document.getElementById('key').value;
              fetch(`/settings/update?setting=pterodactyl.domain&value=${encodeURIComponent(url)}&token=${__csrf}`)
                .then(r => r.ok ? fetch(`/settings/update?setting=pterodactyl.key&value=${encodeURIComponent(key)}&token=${__csrf}`) : Promise.reject())
                .then(r => r.ok ? window.location.href = '/settings?err=none' : Promise.reject())
                .catch(() => alert('Failed to update Pterodactyl settings'));
            }

            function updateOAuth2() {
              const id = document.getElementById('cID').value;
              const secret = document.getElementById('cSecret').value;
              const rawUrl = document.getElementById('callbackUrl').value;
              const url = rawUrl.startsWith('http') ? rawUrl.replace('/callback', '') : 'https://' + rawUrl.replace('/callback', '');
              fetch(`/settings/update?setting=api.client.oauth2.id&value=${encodeURIComponent(id)}&token=${__csrf}`)
                .then(r => r.ok ? fetch(`/settings/update?setting=api.client.oauth2.secret&value=${encodeURIComponent(secret)}&token=${__csrf}`) : Promise.reject())
                .then(r => r.ok ? fetch(`/settings/update?setting=api.client.oauth2.link&value=${encodeURIComponent(url)}&token=${__csrf}`) : Promise.reject())
                .then(r => r.ok ? window.location.href = '/settings?err=none' : Promise.reject())
                .catch(() => alert('Failed to update OAuth2 settings'));
            }
          </script>
<%- include("../layouts/tail") %>
