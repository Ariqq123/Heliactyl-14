<head>
  <title>Logs · <%= settings.name %></title>
  <link rel="icon" type="image/x-icon" href="../assets/favicon.png">
  <link rel="stylesheet" href="../assets/tailwind.css">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://unpkg.com/@popperjs/core@2.10.1/dist/umd/popper.min.js"></script>
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>

<body class="bg-gray-100 flex h-screen overflow-x-hidden" style="font-family: 'Inter', sans-serif;">
  <%- include('../components/navigation') %>
  <div class="flex-1 min-w-0 flex flex-col h-screen overflow-y-auto">
    <main class="flex-1 pb-32">
      <div class="py-6">
        <%- include('../components/skeleton') %>
        <div class="hidden max-w-7xl pt-8 mx-auto px-4 sm:px-6 md:px-8" id="content">

          <!-- Hero -->
          <div class="relative overflow-hidden bg-white border border-gray-200/60 rounded-3xl mb-8 p-8 shadow-sm">
            <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-gradient-to-br from-violet-50 to-blue-100 opacity-50 blur-3xl"></div>
            <div class="relative lg:flex lg:items-center lg:justify-between">
              <div class="flex items-center">
                <div class="bg-violet-50 border border-violet-100/50 rounded-2xl h-14 w-14 flex items-center justify-center text-violet-500 shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path fill-rule="evenodd" d="M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6Zm6.75 0a.75.75 0 0 0 0 1.5h7.5a.75.75 0 0 0 0-1.5h-7.5Zm-3 0a.75.75 0 0 0-1.5 0v.008a.75.75 0 0 0 1.5 0V6Zm3 6a.75.75 0 0 0 0 1.5h7.5a.75.75 0 0 0 0-1.5h-7.5Zm-3 0a.75.75 0 0 0-1.5 0v.008a.75.75 0 0 0 1.5 0V12Zm3 6a.75.75 0 0 0 0 1.5h7.5a.75.75 0 0 0 0-1.5h-7.5Zm-3 0a.75.75 0 0 0-1.5 0v.008a.75.75 0 0 0 1.5 0V18Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-5">
                  <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Activity Logs</h2>
                  <p class="mt-1 text-sm text-gray-500">In-memory log buffer (last <%= logs.length %> events) from this worker.</p>
                </div>
              </div>
              <div class="mt-6 lg:mt-0 flex gap-3">
                <button onclick="filterLogs()" class="inline-flex items-center rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5" /></svg>
                  Filter
                </button>
                <button onclick="window.location.reload()" class="inline-flex items-center rounded-xl bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                  Refresh
                </button>
              </div>
            </div>
          </div>

          <!-- Filter input -->
          <div class="bg-white border border-gray-200/60 rounded-3xl p-4 shadow-sm mb-6 hidden" id="filterPane">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input type="text" id="filterQuery" placeholder="Search action or message..." class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm text-gray-700 shadow-sm focus:border-violet-400 focus:ring-violet-500 placeholder:text-gray-400" oninput="applyFilter()">
              <input type="text" id="filterCid" placeholder="Filter by correlation ID..." class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm text-gray-700 shadow-sm focus:border-violet-400 focus:ring-violet-500 placeholder:text-gray-400" oninput="applyFilter()">
            </div>
          </div>

          <% if (!logs || logs.length === 0) { %>
          <div class="text-center bg-white border border-gray-200/60 rounded-3xl py-24 px-6 shadow-sm">
            <div class="mx-auto h-16 w-16 bg-gray-50 rounded-2xl flex items-center justify-center border border-gray-100 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8 text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25M9 16.5v.75m3-3v3M15 12v5.25m-4.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
            </div>
            <h3 class="text-lg font-bold tracking-tight text-gray-900">No logs yet</h3>
            <p class="mt-2 text-sm text-gray-500">Logs will appear here as soon as actions happen.</p>
          </div>
          <% } else { %>
          <div class="bg-white border border-gray-200/60 rounded-3xl overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200" id="logsTable">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Time</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">CID</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Action</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Message</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100" id="logsBody">
                  <% for (let i = 0; i < logs.length; i++) { let entry = logs[i]; %>
                  <tr class="hover:bg-gray-50 transition-colors log-row" data-action="<%= entry.action.toLowerCase() %>" data-message="<%= entry.message.toLowerCase() %>" data-cid="<%= entry.correlationId || '' %>">
                    <td class="px-4 py-3 text-xs text-gray-500" style="font-family: 'JetBrains Mono', monospace;"><%= entry.timestamp %></td>
                    <td class="px-4 py-3 text-xs">
                      <% if (entry.correlationId) { %>
                      <span class="inline-flex rounded-full bg-violet-100 text-violet-700 px-2.5 py-1 font-mono"><%= entry.correlationId %></span>
                      <% } else { %>
                      <span class="text-gray-300">—</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3 text-sm font-medium text-gray-900"><span class="inline-flex rounded-full bg-emerald-50 text-emerald-700 px-2.5 py-1 text-xs"><%= entry.action %></span></td>
                    <td class="px-4 py-3 text-sm text-gray-600 break-all"><%= entry.message %></td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
            <div class="bg-gray-50 px-4 py-3 border-t border-gray-200 text-xs text-gray-500 flex items-center justify-between">
              <span>Showing <span id="visibleCount"><%= logs.length %></span> / <%= logs.length %> entries</span>
              <span class="font-mono">PID <%= process.pid %></span>
            </div>
          </div>
          <% } %>

          <script>
            function filterLogs() {
              const pane = document.getElementById('filterPane');
              pane.classList.toggle('hidden');
            }
            function applyFilter() {
              const q = document.getElementById('filterQuery').value.toLowerCase().trim();
              const cid = document.getElementById('filterCid').value.toLowerCase().trim();
              const rows = document.querySelectorAll('.log-row');
              let visible = 0;
              rows.forEach(r => {
                const a = r.dataset.action || '';
                const m = r.dataset.message || '';
                const c = (r.dataset.cid || '').toLowerCase();
                const matchQ = !q || a.includes(q) || m.includes(q);
                const matchCid = !cid || c.includes(cid);
                if (matchQ && matchCid) { r.classList.remove('hidden'); visible++; }
                else { r.classList.add('hidden'); }
              });
              document.getElementById('visibleCount').textContent = visible;
            }
          </script>

        </div>
      </div>
    </main>
    <%- include('../components/footer') %>
  </div>
</body>
