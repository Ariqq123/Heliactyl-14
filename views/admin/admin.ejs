<head>
  <title><%= settings.name %></title>
  <link rel="icon" type="image/x-icon" href="../assets/favicon.png">
  <link rel="stylesheet" href="../assets/tailwind.css">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://unpkg.com/@popperjs/core@2.10.1/dist/umd/popper.min.js"></script>
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    fetch('https://atqr.pages.dev/heliactyl.json')
      .then(r => r.json())
      .then(data => {
        const currentVersion = '<%= settings.version %>';
        const latestVersion = data.latest;
        document.getElementById('currentVersion').textContent = currentVersion;
        const status = document.getElementById('versionStatus');
        if (currentVersion === latestVersion) {
          status.textContent = 'You are running the latest version.';
          status.className = 'text-emerald-600 text-xs mt-2 font-medium';
        } else {
          status.innerHTML = 'Heliactyl <strong>' + latestVersion + '</strong> is available. <a class="underline hover:text-amber-700" href="https://github.com/heliactyloss/heliactyl/releases/tag/' + latestVersion + '">View release</a>';
          status.className = 'text-amber-600 text-xs mt-2 font-medium';
        }
        document.getElementById('content').classList.remove('hidden');
      })
      .catch(() => document.getElementById('content').classList.remove('hidden'));
  </script>
</head>

<body class="bg-gray-100 flex h-screen overflow-x-hidden" style="font-family: 'Inter', sans-serif;">
  <%- include('../components/navigation') %>
  <div class="flex-1 min-w-0 flex flex-col h-screen overflow-y-auto">
    <main class="flex-1 pb-32">
      <div class="py-6">
        <%- include('../components/skeleton') %>
        <div class="hidden max-w-7xl pt-8 mx-auto px-4 sm:px-6 md:px-8" id="content">

          <!-- Hero -->
          <div class="relative overflow-hidden bg-white border border-gray-200/60 rounded-3xl mb-8 p-8 shadow-sm">
            <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-gradient-to-br from-rose-50 to-fuchsia-100 opacity-50 blur-3xl"></div>
            <div class="relative lg:flex lg:items-center lg:justify-between">
              <div class="flex items-center">
                <div class="bg-rose-50 border border-rose-100/50 rounded-2xl h-14 w-14 flex items-center justify-center text-rose-500 shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path fill-rule="evenodd" d="M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6Zm14.25 6a.75.75 0 0 1-.22.53l-2.25 2.25a.75.75 0 1 1-1.06-1.06L15.44 12l-1.72-1.72a.75.75 0 1 1 1.06-1.06l2.25 2.25c.141.14.22.331.22.53Zm-10.28-.53a.75.75 0 0 0 0 1.06l2.25 2.25a.75.75 0 1 0 1.06-1.06L8.56 12l1.72-1.72a.75.75 0 1 0-1.06-1.06l-2.25 2.25Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-5">
                  <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Admin Tools</h2>
                  <p class="mt-1 text-sm text-gray-500">User management, resources, and account control.</p>
                </div>
              </div>
              <a href="/settings" class="mt-6 lg:mt-0 inline-flex items-center rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 0 1 1.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.27 1.06-.12 1.45l-.774.773a1.125 1.125 0 0 1-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.398.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.27-1.45-.12l-.773-.774a1.125 1.125 0 0 1-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 0 1 .12-1.45l.773-.773a1.125 1.125 0 0 1 1.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" /></svg>
                System Settings
              </a>
            </div>
          </div>

          <!-- Alert -->
          <% if (req.query.err && req.query.err !== 'none') { %>
          <div class="rounded-2xl bg-rose-50 border border-rose-200 p-6 mb-6">
            <div class="flex">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 text-rose-500 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-rose-800">Action failed</h3>
                <p class="mt-1 text-sm text-rose-700">Error code: <code><%= req.query.err %></code></p>
              </div>
            </div>
          </div>
          <% } %>
          <% if (req.query.err && req.query.err == 'none') { %>
          <div class="rounded-2xl bg-emerald-50 border border-emerald-200 p-6 mb-6">
            <div class="flex">
              <svg class="h-6 w-6 text-emerald-500 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
              <div class="ml-3"><h3 class="text-sm font-medium text-emerald-800">Action successful</h3><p class="mt-1 text-sm text-emerald-700">The requested admin action completed successfully.</p></div>
            </div>
          </div>
          <% } %>
          <% if (req.query.success) { %>
          <div class="rounded-2xl bg-emerald-50 border border-emerald-200 p-6 mb-6">
            <div class="flex">
              <svg class="h-6 w-6 text-emerald-500 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
              <div class="ml-3"><h3 class="text-sm font-medium text-emerald-800">Action successful</h3><p class="mt-1 text-sm text-emerald-700">Code: <code><%= req.query.success %></code></p></div>
            </div>
          </div>
          <% } %>

          <!-- Version Info -->
          <div class="bg-white border border-gray-200/60 rounded-3xl p-6 shadow-sm mb-8 flex items-center justify-between">
            <div>
              <h3 class="text-base font-semibold text-gray-900">Heliactyl <span id="currentVersion" class="font-mono"></span></h3>
              <p id="versionStatus" class="text-xs mt-2"></p>
            </div>
            <img src="https://atqr.pages.dev/v2Favicon.png" class="h-12 rounded-xl bg-gray-100 p-2">
          </div>

          <!-- Action cards -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- Add coins -->
            <div class="bg-white border border-gray-200/60 rounded-3xl p-8 shadow-sm">
              <div class="flex items-center mb-5">
                <div class="bg-amber-50 text-amber-600 rounded-xl p-2.5"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path d="M8 12.5c1.84 0 3.579-.37 4.914-1.037.366-.183.74-.41 1.086-.684V12c0 1.657-2.686 3-6 3s-6-1.343-6-3v-1.22c.346.273.72.5 1.087.683C4.42 12.131 6.16 12.5 8 12.5Z" /></svg></div>
                <h3 class="ml-3 text-lg font-semibold text-gray-900">Add Coins</h3>
              </div>
              <div class="space-y-4">
                <div>
                  <label class="text-sm font-medium text-gray-700">Discord ID</label>
                  <input type="text" id="id1" placeholder="000000000000000000" class="mt-2 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-sm focus:border-amber-400 focus:ring-amber-500 placeholder:text-gray-400">
                </div>
                <div>
                  <label class="text-sm font-medium text-gray-700">Amount</label>
                  <input type="text" id="amount1" placeholder="100" class="mt-2 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-sm focus:border-amber-400 focus:ring-amber-500 placeholder:text-gray-400">
                </div>
              </div>
              <button onclick="addCoins()" class="mt-6 inline-flex items-center rounded-xl bg-amber-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-700 transition-colors">Add Coins</button>
            </div>

            <!-- Add resources -->
            <div class="bg-white border border-gray-200/60 rounded-3xl p-8 shadow-sm">
              <div class="flex items-center mb-5">
                <div class="bg-indigo-50 text-indigo-600 rounded-xl p-2.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" /></svg></div>
                <h3 class="ml-3 text-lg font-semibold text-gray-900">Add Resources</h3>
              </div>
              <div class="space-y-4">
                <div>
                  <label class="text-sm font-medium text-gray-700">Discord ID</label>
                  <input type="text" id="id2" placeholder="000000000000000000" class="mt-2 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-sm focus:border-indigo-400 focus:ring-indigo-500 placeholder:text-gray-400">
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="text-xs font-medium text-gray-500">CPU Cores</label>
                    <input type="text" id="cpu" placeholder="1" class="mt-1 w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-indigo-400 focus:ring-indigo-500 placeholder:text-gray-400">
                  </div>
                  <div>
                    <label class="text-xs font-medium text-gray-500">Memory (GiB)</label>
                    <input type="text" id="memory" placeholder="2" class="mt-1 w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-indigo-400 focus:ring-indigo-500 placeholder:text-gray-400">
                  </div>
                  <div>
                    <label class="text-xs font-medium text-gray-500">Storage (GiB)</label>
                    <input type="text" id="storage" placeholder="10" class="mt-1 w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-indigo-400 focus:ring-indigo-500 placeholder:text-gray-400">
                  </div>
                  <div>
                    <label class="text-xs font-medium text-gray-500">Server Slots</label>
                    <input type="text" id="servers" placeholder="5" class="mt-1 w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 shadow-sm focus:border-indigo-400 focus:ring-indigo-500 placeholder:text-gray-400">
                  </div>
                </div>
              </div>
              <button onclick="addResources()" class="mt-6 inline-flex items-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors">Add Resources</button>
            </div>

            <!-- Delete account -->
            <div class="bg-white border-2 border-rose-200 rounded-3xl p-8 shadow-sm lg:col-span-2">
              <div class="flex items-center mb-5">
                <div class="bg-rose-50 text-rose-600 rounded-xl p-2.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg></div>
                <div class="ml-3">
                  <h3 class="text-lg font-semibold text-gray-900">Delete Account</h3>
                  <p class="text-xs text-rose-600 mt-0.5">This removes the linked account, coins, package, and dashboard data.</p>
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-3 sm:items-end">
                <div class="flex-1">
                  <label class="text-sm font-medium text-gray-700">Discord ID</label>
                  <input type="text" id="id3" placeholder="000000000000000000" class="mt-2 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-sm focus:border-rose-400 focus:ring-rose-500 placeholder:text-gray-400">
                </div>
                <button onclick="removeAccount()" class="inline-flex items-center justify-center rounded-xl bg-rose-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-rose-700 transition-colors">Delete Account</button>
              </div>
            </div>

          </div>

          <script>
            function addCoins() {
              let id = encodeURIComponent(document.getElementById('id1').value);
              let amount = encodeURIComponent(document.getElementById('amount1').value);
              document.location.href = '/addcoins?id=' + id + '&coins=' + amount;
            }
            function addResources() {
              let id = encodeURIComponent(document.getElementById('id2').value);
              let cpu = encodeURIComponent(document.getElementById('cpu').value * 100);
              let memory = encodeURIComponent(document.getElementById('memory').value * 1024);
              let storage = encodeURIComponent(document.getElementById('storage').value * 1024);
              let servers = encodeURIComponent(document.getElementById('servers').value);
              document.location.href = '/addresources?id=' + id + '&cpu=' + cpu + '&ram=' + memory + '&disk=' + storage + '&servers=' + servers;
            }
            function removeAccount() {
              if (!confirm('Are you sure you want to permanently delete this account?')) return;
              let id = encodeURIComponent(document.getElementById('id3').value);
              document.location.href = '/remove_account?id=' + id;
            }
          </script>

        </div>
      </div>
    </main>
    <%- include('../components/footer') %>
  </div>
</body>
