<%- include('../layouts/base-head') %>
<style>
  body { font-family: 'Inter', sans-serif; }
  .bg-grid-pattern {
    background-image: radial-gradient(circle at 1px 1px, rgb(203 213 225 / 0.4) 1px, transparent 0);
    background-size: 24px 24px;
  }
</style>
<body class="h-full bg-slate-50 dark:bg-slate-900 antialiased relative overflow-hidden">
  <!-- Subtle grid background -->
  <div class="absolute inset-0 bg-grid-pattern pointer-events-none"></div>
  <!-- Gradient blur blobs -->
  <div class="absolute -top-24 -left-24 w-72 h-72 bg-indigo-100 rounded-full blur-3xl opacity-40 pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-rose-100 rounded-full blur-3xl opacity-30 pointer-events-none"></div>

  <main class="relative grid min-h-full place-items-center px-6 py-24 sm:py-32 lg:px-8 z-10">
    <div class="text-center">
      <div class="inline-flex items-center justify-center bg-rose-100 text-rose-600 font-bold px-3 py-1 rounded-full text-sm mb-4">
        Error 404
      </div>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl">Page not found</h1>
      <p class="mt-6 text-base leading-7 text-slate-500">Sorry, we couldn't find the page you're looking for.</p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a href="../dashboard" class="transition inline-flex items-center justify-center rounded-xl bg-indigo-600 px-8 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          Back to Dashboard
        </a>
      </div>
    </div>
  </main>
</body>
</html>
