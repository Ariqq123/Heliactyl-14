  "modrinth_mrpack": {
    "display": "Modrinth MRPack",
    "minimum": { "ram": 1024, "disk": 1024, "cpu": 100 },
    "maximum": { "ram": null, "disk": null, "cpu": null },
    "info": {
      "egg": 20,
      "docker_image": "ghcr.io/parkervcp/yolks:java_21",
      "startup": "set -e; LAUNCH_SCRIPT=\"\"; for candidate in run.sh start.sh serverstart.sh launch.sh; do if [ -f \"$candidate\" ]; then LAUNCH_SCRIPT=\"$candidate\"; break; fi; done; if [ -n \"$LAUNCH_SCRIPT\" ]; then chmod +x \"$LAUNCH_SCRIPT\" && echo \"Using launch script: $LAUNCH_SCRIPT\" && bash \"$LAUNCH_SCRIPT\"; elif [ -f user_jvm_args.txt ]; then UNIX_ARGS=$(find libraries -type f -name unix_args.txt | sort | head -n 1); if [ -n \"$UNIX_ARGS\" ]; then echo \"Using argfiles: user_jvm_args.txt + $UNIX_ARGS\"; java @user_jvm_args.txt @\"$UNIX_ARGS\"; else echo \"Found user_jvm_args.txt but no unix_args.txt under libraries/\"; exit 1; fi; elif [ -n \"{{SERVER_JARFILE}}\" ] && [ -f \"{{SERVER_JARFILE}}\" ]; then echo \"Using configured jar: {{SERVER_JARFILE}}\"; java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar \"{{SERVER_JARFILE}}\"; else JAR=$(find . -maxdepth 1 -type f \\( -name \"server.jar\" -o -name \"neoforge-*.jar\" -o -name \"forge-*.jar\" -o -name \"fabric-server-*.jar\" -o -name \"quilt-server-*.jar\" -o -name \"*.jar\" \\) ! -name \"*installer*\" | sort | head -n 1); if [ -n \"$JAR\" ]; then echo \"Auto-detected server jar: $JAR\"; java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar \"$JAR\"; else echo \"No startup target found\"; exit 1; fi; fi",
      "environment": {
        "SERVER_JARFILE": "server.jar",
        "MRPACK_URL": "",
        "MRPACK_FILE": "",
        "MINECRAFT_VERSION": "latest",
        "MOD_LOADER": "",
        "LOADER_VERSION": "",
        "INCLUDE_CLIENT_OVERRIDES": "0",
        "JAVA_VERSION": ""
      },
      "feature_limits": { "databases": 4, "backups": 4 }
    }
  }
}
